# Sandcastle ONLY forwards environment variables explicitly listed in .sandcastle/.env.
# With ChatGPT/Enterprise Codex auth (~/.codex/auth.json readonly bind-mount), no API key is required here.
#
# Optional overrides (copy this file to .sandcastle/.env if needed):
CODEX_MODEL=gpt-5.4
TRACKER_MODE=local
SANDCASTLE_IMAGE=sandcastle:python-codex
